node_modules/
dist/

# Segredos nunca entram no repositório.
.env
.env.*
.dev.vars
# ...menos o MODELO, que não tem segredo nenhum e é o que o README manda copiar.
# Sem esta linha, `.env.*` engolia o próprio exemplo: ele nunca foi versionado, e
# quem clonasse o projeto lia "copie .env.exemplo" sobre um arquivo inexistente.
!.env.exemplo

# Configuração do Supabase: contém a chave anon, que é pública por natureza
# (vai no bundle do site). Fica fora do git só para cada ambiente ter a sua.
public/supabase.json

# Chaves da devnet: são só de teste e sem valor, mas chave secreta não entra
# em repositório por princípio — se um dia alguém apontar este script para a
# mainnet, o hábito errado já estaria instalado.
onchain/chaves/

*.log
.DS_Store

# temporários dos testes
testes/.tmp*/

# capturas de tela geradas por `npm test -- telas` (conferência visual)
capturas/

# As respostas do formulário trazem dado pessoal da líder da equipe: nome
# completo, idade, telefone, e-mail pessoal, gênero e cor/raça autodeclarados.
# Nada disso pode ir para um repositório público — e o repositório é público.
# O arquivo fica no disco de quem preenche, e vai para o formulário do edital.
SUBMISSAO.md

# Módulo de Validação de Coleta: ambiente e dados do pipeline de modelo.
# Os datasets são públicos e baixáveis (`python -m raizes_modelo.dados.preparar`),
# e somam centenas de MB. As execuções de treino são reproduzíveis a partir da
# configuração versionada, então o checkpoint também não precisa entrar no git.
modelo/.venv/
modelo/dados/
modelo/execucoes/
modelo/**/__pycache__/
modelo/.pytest_cache/

# O ONNX exportado é artefato de build, gerado por `raizes_modelo.exportar`.
# Fica de fora por padrão porque são megabytes que mudam a cada retreino.
public/modelo/*.onnx
public/modelo/*.json

# Menos o modelo que está publicado. Sem ele em produção o app de campo cai na
# escolha manual de material e o reconhecimento pela câmera simplesmente não
# existe para quem usa o site — só para quem roda o projeto com o modelo na
# máquina. São 5,9 MB versionados de propósito: é o preço de publicar sem uma
# etapa de treino no deploy, que a Vercel não tem como rodar (é Python e leva
# minutos). Ao retreinar, exportar e commitar a versão nova por cima.
# O `-fp32` continua de fora: o manifesto não o carrega.
!public/modelo/classificador.onnx
!public/modelo/classificador.json
